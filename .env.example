# Lokalis fejleszteshez maradhat development.
# Eles szerveren allitsd production-re, es HTTPS/reverse proxy mogott COOKIE_SECURE=true legyen.
APP_ENV=development
NODE_ENV=development

# Lokalisan 127.0.0.1, publikus szerveren 0.0.0.0.
HOST=127.0.0.1
PORT=8766

# Opcionális, csak a hitelesített QA ellenőrzésekhez.
QA_BASE_URL=http://127.0.0.1:8766
QA_LOGIN=
QA_PASSWORD=

# MySQL. Elesben ne root felhasznalot hasznalj, hanem kulon maffia DB usert.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=maffia_user
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=maffia
MYSQL_CONNECTION_LIMIT=10

# Session/cookie.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
SESSION_MAX_AGE_SECONDS=2592000

# Szerver limitek.
REQUEST_BODY_LIMIT_BYTES=2000000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000
API_RATE_LIMIT_WINDOW_MS=60000
API_READ_RATE_LIMIT_MAX=900
API_WRITE_RATE_LIMIT_MAX=240
MAX_HEADERS_COUNT=96
MAX_CONNECTIONS=0
SHUTDOWN_TIMEOUT_MS=10000
SERVER_LOG_FILE=
SERVER_LOG_TO_STDOUT=true

# Csak HTTPS reverse proxy mogott kapcsold true-ra.
ENABLE_HSTS=false
