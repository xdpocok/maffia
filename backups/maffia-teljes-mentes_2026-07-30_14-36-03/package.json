{
  "name": "maffia-birodalom",
  "private": true,
  "version": "1.0.0",
  "description": "Maffia: Birodalomepito local online-ready server",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "audit:assets": "python scripts/audit-assets.py --output performance/asset-report-after.json",
    "assets:responsive": "python scripts/generate-responsive-assets.py",
    "check:performance": "node scripts/check-performance.mjs",
    "lighthouse": "lighthouse http://127.0.0.1:8766 --config-path=performance/lighthouse.config.cjs --output=html --output=json --output-path=performance/lighthouse"
  },
  "dependencies": {
    "mysql2": "^3.22.5"
  },
  "devDependencies": {
    "lighthouse": "^13.4.0"
  }
}
